{
	"name": "apple-rag-cli",
	"version": "2.1.0",
	"description": "Apple developer knowledge for AI agents. Search and read sources through the Apple RAG CLI.",
	"type": "module",
	"license": "MIT",
	"bin": {
		"apple-rag": "dist/cli.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"skills"
	],
	"engines": {
		"node": ">=22.20.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/BingoWon/apple-rag-mcp.git",
		"directory": "packages/cli"
	},
	"homepage": "https://apple-rag.com",
	"publishConfig": {
		"access": "public",
		"provenance": false
	},
	"scripts": {
		"build": "vite build --config vite.config.ts && node scripts/prepare-package.mjs",
		"prepack": "pnpm run build",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "tsx --test test/*.test.ts"
	},
	"dependencies": {
		"@napi-rs/keyring": "2.1.2",
		"zod": "^4.3.6"
	}
}
