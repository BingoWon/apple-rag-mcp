{
	"name": "apple-rag-mcp",
	"version": "5.0.6",
	"private": true,
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@11.18.0",
	"engines": {
		"node": ">=22.16.0",
		"pnpm": ">=11.0.0"
	},
	"scripts": {
		"dev": "vite",
		"prebuild": "pnpm verify",
		"build": "vite build",
		"test": "tsx --test src/utils/*.test.ts worker/api/routes/*.test.ts worker/collector/*.test.ts worker/mcp/*.test.ts worker/mcp-services/*.test.ts worker/shared/*.test.ts",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json",
		"verify": "pnpm lint && pnpm typecheck && pnpm test",
		"check": "pnpm verify",
		"db:migrate": "wrangler d1 migrations apply apple-rag-db --remote",
		"deploy": "pnpm build && pnpm db:migrate && wrangler deploy"
	},
	"dependencies": {
		"@hono/swagger-ui": "^0.6.1",
		"@hono/zod-openapi": "^1.6.1",
		"@hookform/resolvers": "^5.1.1",
		"@modelcontextprotocol/server": "2.0.0",
		"@radix-ui/react-label": "^2.1.7",
		"@radix-ui/react-slot": "^1.2.4",
		"@stripe/react-stripe-js": "^6.8.2",
		"@stripe/stripe-js": "^9.15.0",
		"@tabler/icons-react": "^3.34.1",
		"apexcharts": "^5.3.2",
		"axios": "^1.20.0",
		"bcryptjs": "^3.0.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"hono": "^4.13.5",
		"i18next": "^25.8.18",
		"motion": "^12.37.0",
		"postgres": "^3.4.9",
		"react": "^19.2.8",
		"react-apexcharts": "^1.7.0",
		"react-dom": "^19.2.8",
		"react-hook-form": "^7.60.0",
		"react-hot-toast": "^2.6.0",
		"react-i18next": "^16.5.8",
		"react-router-dom": "^7.18.3",
		"resend": "^4.8.0",
		"stripe": "^22.6.0",
		"tailwind-merge": "^3.5.0",
		"zod": "^4.3.6",
		"zustand": "^5.0.12"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@cloudflare/vite-plugin": "^1.54.2",
		"@cloudflare/workers-types": "^5.20260901.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.20.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"@vitejs/plugin-react": "^6.1.1",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.13",
		"tw-animate-css": "^1.3.6",
		"typescript": "^5.9.3",
		"vite": "^8.2.2",
		"wrangler": "^4.128.0"
	}
}
