{
	"name": "apple-rag-mcp",
	"version": "5.18.2",
	"mcpName": "com.apple-rag/mcp-server",
	"private": true,
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@11.18.0",
	"engines": {
		"node": ">=22.20.0",
		"pnpm": ">=11.0.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"build:cli": "pnpm --filter apple-rag-cli build",
		"build:all": "pnpm build:cli && pnpm build",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "node .github/scripts/run-parallel.mjs \"tsc:web::tsc --noEmit -p tsconfig.json\" \"tsc:worker::tsc --noEmit -p worker/tsconfig.json\"",
		"typecheck:cli": "pnpm --filter apple-rag-cli typecheck",
		"verify": "node .github/scripts/run-parallel.mjs \"lint::biome check .\" \"tsc:web::tsc --noEmit -p tsconfig.json\" \"tsc:worker::tsc --noEmit -p worker/tsconfig.json\"",
		"check": "pnpm verify",
		"db:migrate": "wrangler d1 migrations apply apple-rag-db --remote"
	},
	"dependencies": {
		"@hono/swagger-ui": "^0.6.1",
		"@hono/zod-openapi": "^1.6.1",
		"@hookform/resolvers": "^5.1.1",
		"@modelcontextprotocol/server": "2.3.1",
		"@radix-ui/react-dialog": "^1.3.1",
		"@radix-ui/react-dropdown-menu": "^2.2.1",
		"@radix-ui/react-label": "^2.1.7",
		"@radix-ui/react-slot": "^1.2.4",
		"@tabler/icons-react": "^3.34.1",
		"@thesvg/react": "4.0.12",
		"apexcharts": "^5.3.2",
		"axios": "^1.20.0",
		"bcryptjs": "^3.0.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"hono": "^4.13.5",
		"i18next": "^25.9.08",
		"jose": "6.2.15",
		"motion": "^12.37.0",
		"postgres": "3.4.9",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-hook-form": "^7.60.0",
		"react-hot-toast": "^2.6.0",
		"react-i18next": "^16.5.8",
		"react-router-dom": "^7.18.3",
		"react-syntax-highlighter": "^15.6.1",
		"resend": "^4.8.0",
		"stripe": "^18.4.0",
		"tailwind-merge": "^3.5.0",
		"zod": "^4.3.6",
		"zustand": "^5.0.12"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@cloudflare/vite-plugin": "^1.54.2",
		"@cloudflare/workers-types": "^5.20260901.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.20.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"@types/react-syntax-highlighter": "^15.5.13",
		"@vitejs/plugin-react": "^6.1.1",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.13",
		"tw-animate-css": "^1.3.6",
		"typescript": "^5.9.3",
		"vite": "^8.2.2",
		"wrangler": "^4.128.0"
	}
}
